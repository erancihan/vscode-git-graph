{
	"name": "vscode-git-graph",
	"displayName": "%displayName%",
	"version": "2.5.0",
	"publisher": "erancihan",
	"author": {
		"name": "Cihan Eran"
	},
	"contributors": [
		{
			"name": "Michael Hutchison",
			"url": "https://github.com/mhutchie"
		}
	],
	"description": "%description%",
	"keywords": [
		"git",
		"graph",
		"visualise",
		"visualize",
		"diff",
		"action",
		"history",
		"log"
	],
	"categories": [
		"SCM Providers",
		"Other"
	],
	"homepage": "https://github.com/erancihan/vscode-git-graph",
	"repository": {
		"type": "git",
		"url": "https://github.com/erancihan/vscode-git-graph.git"
	},
	"bugs": {
		"url": "https://github.com/erancihan/vscode-git-graph/issues"
	},
	"license": "MIT",
	"icon": "resources/icon.png",
	"engines": {
		"vscode": "^1.74.0"
	},
	"extensionKind": [
		"workspace"
	],
	"capabilities": {
		"virtualWorkspaces": false,
		"untrustedWorkspaces": {
			"supported": false
		}
	},
	"activationEvents": [
		"onStartupFinished"
	],
	"main": "./out/extension.js",
	"l10n": "./l10n",
	"contributes": {
		"commands": [
			{
				"category": "Git Graph",
				"command": "git-graph.view",
				"title": "%command.view.title%",
				"icon": {
					"light": "resources/webview-icon-light.svg",
					"dark": "resources/webview-icon-dark.svg"
				}
			},
			{
				"category": "Git Graph",
				"command": "git-graph.clearAvatarCache",
				"title": "%command.clearAvatarCache.title%"
			},
			{
				"category": "Git Graph",
				"command": "git-graph.addGitRepository",
				"title": "%command.addGitRepository.title%"
			},
			{
				"category": "Git Graph",
				"command": "git-graph.removeGitRepository",
				"title": "%command.removeGitRepository.title%"
			},
			{
				"category": "Git Graph",
				"command": "git-graph.fetch",
				"title": "%command.fetch.title%"
			},
			{
				"category": "Git Graph",
				"command": "git-graph.version",
				"title": "%command.version.title%"
			},
			{
				"category": "Git Graph",
				"command": "git-graph.endAllWorkspaceCodeReviews",
				"title": "%command.endAllWorkspaceCodeReviews.title%"
			},
			{
				"category": "Git Graph",
				"command": "git-graph.endSpecificWorkspaceCodeReview",
				"title": "%command.endSpecificWorkspaceCodeReview.title%"
			},
			{
				"category": "Git Graph",
				"command": "git-graph.resumeWorkspaceCodeReview",
				"title": "%command.resumeWorkspaceCodeReview.title%"
			},
			{
				"category": "Git Graph",
				"command": "git-graph.openFile",
				"title": "%command.openFile.title%",
				"icon": "$(go-to-file)"
			}
		],
		"configuration": {
			"type": "object",
			"title": "%config.title%",
			"properties": {
				"git-graph.commitDetailsView.autoCenter": {
					"type": "boolean",
					"default": true,
					"description": "%config.commitDetailsView.autoCenter.description%"
				},
				"git-graph.commitDetailsView.fileView.fileTree.compactFolders": {
					"type": "boolean",
					"default": true,
					"description": "%config.commitDetailsView.fileView.fileTree.compactFolders.description%"
				},
				"git-graph.commitDetailsView.location": {
					"type": "string",
					"enum": [
						"Inline",
						"Docked to Bottom"
					],
					"enumDescriptions": [
						"%config.commitDetailsView.location.enumDescriptions.0%",
						"%config.commitDetailsView.location.enumDescriptions.1%"
					],
					"default": "Inline",
					"description": "%config.commitDetailsView.location.description%"
				},
				"git-graph.commitDetailsView.fileView.showChangeTypeLetters": {
					"type": "boolean",
					"default": false,
					"description": "%config.commitDetailsView.fileView.showChangeTypeLetters.description%"
				},
				"git-graph.commitDetailsView.fileView.type": {
					"type": "string",
					"enum": [
						"File Tree",
						"File List"
					],
					"enumDescriptions": [
						"%config.commitDetailsView.fileView.type.enumDescriptions.0%",
						"%config.commitDetailsView.fileView.type.enumDescriptions.1%"
					],
					"default": "File Tree",
					"description": "%config.commitDetailsView.fileView.type.description%"
				},
				"git-graph.contextMenuActionsVisibility": {
					"type": "object",
					"default": {},
					"description": "%config.contextMenuActionsVisibility.description%",
					"properties": {
						"branch": {
							"type": "object",
							"description": "%config.contextMenuActionsVisibility.branch.description%",
							"properties": {
								"checkout": {
									"type": "boolean",
									"default": true,
									"description": "%config.contextMenuActionsVisibility.branch.checkout.description%"
								},
								"rename": {
									"type": "boolean",
									"default": true,
									"description": "%config.contextMenuActionsVisibility.branch.rename.description%"
								},
								"delete": {
									"type": "boolean",
									"default": true,
									"description": "%config.contextMenuActionsVisibility.branch.delete.description%"
								},
								"merge": {
									"type": "boolean",
									"default": true,
									"description": "%config.contextMenuActionsVisibility.branch.merge.description%"
								},
								"copyName": {
									"type": "boolean",
									"default": true,
									"description": "%config.contextMenuActionsVisibility.branch.copyName.description%"
								},
								"rebase": {
									"type": "boolean",
									"default": true,
									"description": "%config.contextMenuActionsVisibility.branch.rebase.description%"
								},
								"push": {
									"type": "boolean",
									"default": true,
									"description": "%config.contextMenuActionsVisibility.branch.push.description%"
								},
								"createPullRequest": {
									"type": "boolean",
									"default": true,
									"description": "%config.contextMenuActionsVisibility.branch.createPullRequest.description%"
								},
								"createWorktree": {
									"type": "boolean",
									"default": true,
									"description": "%config.contextMenuActionsVisibility.branch.createWorktree.description%"
								},
								"archive": {
									"type": "boolean",
									"default": true,
									"description": "%config.contextMenuActionsVisibility.branch.archive.description%"
								}
							},
							"additionalProperties": false
						},
						"commit": {
							"type": "object",
							"description": "%config.contextMenuActionsVisibility.commit.description%",
							"properties": {
								"addTag": {
									"type": "boolean",
									"default": true,
									"description": "%config.contextMenuActionsVisibility.commit.addTag.description%"
								},
								"createBranch": {
									"type": "boolean",
									"default": true,
									"description": "%config.contextMenuActionsVisibility.commit.createBranch.description%"
								},
								"checkout": {
									"type": "boolean",
									"default": true,
									"description": "%config.contextMenuActionsVisibility.commit.checkout.description%"
								},
								"cherrypick": {
									"type": "boolean",
									"default": true,
									"description": "%config.contextMenuActionsVisibility.commit.cherrypick.description%"
								},
								"revert": {
									"type": "boolean",
									"default": true,
									"description": "%config.contextMenuActionsVisibility.commit.revert.description%"
								},
								"merge": {
									"type": "boolean",
									"default": true,
									"description": "%config.contextMenuActionsVisibility.commit.merge.description%"
								},
								"reset": {
									"type": "boolean",
									"default": true,
									"description": "%config.contextMenuActionsVisibility.commit.reset.description%"
								},
								"copyHash": {
									"type": "boolean",
									"default": true,
									"description": "%config.contextMenuActionsVisibility.commit.copyHash.description%"
								},
								"archive": {
									"type": "boolean",
									"default": true,
									"description": "%config.contextMenuActionsVisibility.commit.archive.description%"
								},
								"codeReview": {
									"type": "boolean",
									"default": true,
									"description": "%config.contextMenuActionsVisibility.commit.codeReview.description%"
								},
								"reword": {
									"type": "boolean",
									"default": true,
									"description": "%config.contextMenuActionsVisibility.commit.reword.description%"
								},
								"filterByAuthor": {
									"type": "boolean",
									"default": true,
									"description": "%config.contextMenuActionsVisibility.commit.filterByAuthor.description%"
								},
								"bisect": {
									"type": "boolean",
									"default": true,
									"description": "%config.contextMenuActionsVisibility.commit.bisect.description%"
								},
								"createWorktree": {
									"type": "boolean",
									"default": true,
									"description": "%config.contextMenuActionsVisibility.commit.createWorktree.description%"
								},
								"rebase": {
									"type": "boolean",
									"default": true,
									"description": "%config.contextMenuActionsVisibility.commit.rebase.description%"
								},
								"interactiveRebase": {
									"type": "boolean",
									"default": true,
									"description": "%config.contextMenuActionsVisibility.commit.interactiveRebase.description%"
								},
								"fixup": {
									"type": "boolean",
									"default": true,
									"description": "%config.contextMenuActionsVisibility.commit.fixup.description%"
								},
								"drop": {
									"type": "boolean",
									"default": true,
									"description": "%config.contextMenuActionsVisibility.commit.drop.description%"
								}
							},
							"additionalProperties": false
						},
						"remoteBranch": {
							"type": "object",
							"description": "%config.contextMenuActionsVisibility.remoteBranch.description%",
							"properties": {
								"checkout": {
									"type": "boolean",
									"default": true,
									"description": "%config.contextMenuActionsVisibility.remoteBranch.checkout.description%"
								},
								"copyName": {
									"type": "boolean",
									"default": true,
									"description": "%config.contextMenuActionsVisibility.remoteBranch.copyName.description%"
								},
								"delete": {
									"type": "boolean",
									"default": true,
									"description": "%config.contextMenuActionsVisibility.remoteBranch.delete.description%"
								},
								"fetch": {
									"type": "boolean",
									"default": true,
									"description": "%config.contextMenuActionsVisibility.remoteBranch.fetch.description%"
								},
								"pull": {
									"type": "boolean",
									"default": true,
									"description": "%config.contextMenuActionsVisibility.remoteBranch.pull.description%"
								}
							},
							"additionalProperties": false
						},
						"tag": {
							"type": "object",
							"description": "%config.contextMenuActionsVisibility.tag.description%",
							"properties": {
								"delete": {
									"type": "boolean",
									"default": true,
									"description": "%config.contextMenuActionsVisibility.tag.delete.description%"
								},
								"push": {
									"type": "boolean",
									"default": true,
									"description": "%config.contextMenuActionsVisibility.tag.push.description%"
								},
								"archive": {
									"type": "boolean",
									"default": true,
									"description": "%config.contextMenuActionsVisibility.tag.archive.description%"
								},
								"copyName": {
									"type": "boolean",
									"default": true,
									"description": "%config.contextMenuActionsVisibility.tag.copyName.description%"
								}
							},
							"additionalProperties": false
						},
						"uncommittedChanges": {
							"type": "object",
							"description": "%config.contextMenuActionsVisibility.uncommittedChanges.description%",
							"properties": {
								"reset": {
									"type": "boolean",
									"default": true,
									"description": "%config.contextMenuActionsVisibility.uncommittedChanges.reset.description%"
								},
								"clean": {
									"type": "boolean",
									"default": true,
									"description": "%config.contextMenuActionsVisibility.uncommittedChanges.clean.description%"
								},
								"stash": {
									"type": "boolean",
									"default": true,
									"description": "%config.contextMenuActionsVisibility.uncommittedChanges.stash.description%"
								},
								"amend": {
									"type": "boolean",
									"default": true,
									"description": "%config.contextMenuActionsVisibility.uncommittedChanges.amend.description%"
								}
							},
							"additionalProperties": false
						},
						"stash": {
							"type": "object",
							"description": "%config.contextMenuActionsVisibility.stash.description%",
							"properties": {
								"apply": {
									"type": "boolean",
									"default": true,
									"description": "%config.contextMenuActionsVisibility.stash.apply.description%"
								},
								"createBranch": {
									"type": "boolean",
									"default": true,
									"description": "%config.contextMenuActionsVisibility.stash.createBranch.description%"
								},
								"pop": {
									"type": "boolean",
									"default": true,
									"description": "%config.contextMenuActionsVisibility.stash.pop.description%"
								},
								"drop": {
									"type": "boolean",
									"default": true,
									"description": "%config.contextMenuActionsVisibility.stash.drop.description%"
								},
								"copyName": {
									"type": "boolean",
									"default": true,
									"description": "%config.contextMenuActionsVisibility.stash.copyName.description%"
								},
								"copyHash": {
									"type": "boolean",
									"default": true,
									"description": "%config.contextMenuActionsVisibility.stash.copyHash.description%"
								}
							},
							"additionalProperties": false
						}
					},
					"additionalProperties": false
				},
				"git-graph.customBranchGlobPatterns": {
					"type": "array",
					"items": {
						"type": "object",
						"properties": {
							"name": {
								"type": "string",
								"description": "%config.customBranchGlobPatterns.items.name.description%"
							},
							"glob": {
								"type": "string",
								"description": "%config.customBranchGlobPatterns.items.glob.description%"
							}
						},
						"required": [
							"name",
							"glob"
						],
						"additionalProperties": false
					},
					"default": [],
					"description": "%config.customBranchGlobPatterns.description%"
				},
				"git-graph.customPullRequestProviders": {
					"type": "array",
					"items": {
						"type": "object",
						"properties": {
							"name": {
								"type": "string",
								"description": "%config.customPullRequestProviders.items.name.description%"
							},
							"templateUrl": {
								"type": "string",
								"description": "%config.customPullRequestProviders.items.templateUrl.description%"
							}
						},
						"required": [
							"name",
							"templateUrl"
						],
						"additionalProperties": false
					},
					"default": [],
					"description": "%config.customPullRequestProviders.description%"
				},
				"git-graph.date.format": {
					"type": "string",
					"enum": [
						"Date & Time",
						"Date Only",
						"Relative"
					],
					"enumDescriptions": [
						"%config.date.format.enumDescriptions.0%",
						"%config.date.format.enumDescriptions.1%",
						"%config.date.format.enumDescriptions.2%"
					],
					"default": "Date & Time",
					"description": "%config.date.format.description%"
				},
				"git-graph.date.type": {
					"type": "string",
					"enum": [
						"Author Date",
						"Commit Date"
					],
					"enumDescriptions": [
						"%config.date.type.enumDescriptions.0%",
						"%config.date.type.enumDescriptions.1%"
					],
					"default": "Author Date",
					"description": "%config.date.type.description%"
				},
				"git-graph.defaultColumnVisibility": {
					"type": "object",
					"default": {
						"Date": true,
						"Author": true,
						"Commit": true
					},
					"properties": {
						"Date": {
							"type": "boolean",
							"default": true,
							"description": "%config.defaultColumnVisibility.Date.description%"
						},
						"Author": {
							"type": "boolean",
							"default": true,
							"description": "%config.defaultColumnVisibility.Author.description%"
						},
						"Commit": {
							"type": "boolean",
							"default": true,
							"description": "%config.defaultColumnVisibility.Commit.description%"
						}
					},
					"additionalProperties": false,
					"description": "%config.defaultColumnVisibility.description%"
				},
				"git-graph.dialog.addTag.pushToRemote": {
					"type": "boolean",
					"default": false,
					"description": "%config.dialog.addTag.pushToRemote.description%"
				},
				"git-graph.dialog.addTag.type": {
					"type": "string",
					"enum": [
						"Annotated",
						"Lightweight"
					],
					"default": "Annotated",
					"description": "%config.dialog.addTag.type.description%"
				},
				"git-graph.dialog.applyStash.reinstateIndex": {
					"type": "boolean",
					"default": false,
					"description": "%config.dialog.applyStash.reinstateIndex.description%"
				},
				"git-graph.dialog.cherryPick.noCommit": {
					"type": "boolean",
					"default": false,
					"description": "%config.dialog.cherryPick.noCommit.description%"
				},
				"git-graph.dialog.cherryPick.recordOrigin": {
					"type": "boolean",
					"default": false,
					"description": "%config.dialog.cherryPick.recordOrigin.description%"
				},
				"git-graph.dialog.createBranch.checkOut": {
					"type": "boolean",
					"default": false,
					"description": "%config.dialog.createBranch.checkOut.description%"
				},
				"git-graph.dialog.deleteBranch.forceDelete": {
					"type": "boolean",
					"default": false,
					"description": "%config.dialog.deleteBranch.forceDelete.description%"
				},
				"git-graph.dialog.fetchRemote.prune": {
					"type": "boolean",
					"default": false,
					"description": "%config.dialog.fetchRemote.prune.description%"
				},
				"git-graph.dialog.fetchRemote.pruneTags": {
					"type": "boolean",
					"default": false,
					"description": "%config.dialog.fetchRemote.pruneTags.description%"
				},
				"git-graph.dialog.fetchIntoLocalBranch.forceFetch": {
					"type": "boolean",
					"default": false,
					"description": "%config.dialog.fetchIntoLocalBranch.forceFetch.description%"
				},
				"git-graph.dialog.general.referenceInputSpaceSubstitution": {
					"type": "string",
					"enum": [
						"None",
						"Hyphen",
						"Underscore"
					],
					"enumDescriptions": [
						"%config.dialog.general.referenceInputSpaceSubstitution.enumDescriptions.0%",
						"%config.dialog.general.referenceInputSpaceSubstitution.enumDescriptions.1%",
						"%config.dialog.general.referenceInputSpaceSubstitution.enumDescriptions.2%"
					],
					"default": "None",
					"description": "%config.dialog.general.referenceInputSpaceSubstitution.description%"
				},
				"git-graph.dialog.merge.noCommit": {
					"type": "boolean",
					"default": false,
					"description": "%config.dialog.merge.noCommit.description%"
				},
				"git-graph.dialog.merge.noFastForward": {
					"type": "boolean",
					"default": true,
					"description": "%config.dialog.merge.noFastForward.description%"
				},
				"git-graph.dialog.merge.squashCommits": {
					"type": "boolean",
					"default": false,
					"description": "%config.dialog.merge.squashCommits.description%"
				},
				"git-graph.dialog.merge.squashMessageFormat": {
					"type": "string",
					"enum": [
						"Default",
						"Git SQUASH_MSG"
					],
					"enumDescriptions": [
						"%config.dialog.merge.squashMessageFormat.enumDescriptions.0%",
						"%config.dialog.merge.squashMessageFormat.enumDescriptions.1%"
					],
					"default": "Default",
					"description": "%config.dialog.merge.squashMessageFormat.description%"
				},
				"git-graph.dialog.popStash.reinstateIndex": {
					"type": "boolean",
					"default": false,
					"description": "%config.dialog.popStash.reinstateIndex.description%"
				},
				"git-graph.dialog.pullBranch.noFastForward": {
					"type": "boolean",
					"default": false,
					"description": "%config.dialog.pullBranch.noFastForward.description%"
				},
				"git-graph.dialog.pullBranch.squashMessageFormat": {
					"type": "string",
					"enum": [
						"Default",
						"Git SQUASH_MSG"
					],
					"enumDescriptions": [
						"%config.dialog.pullBranch.squashMessageFormat.enumDescriptions.0%",
						"%config.dialog.pullBranch.squashMessageFormat.enumDescriptions.1%"
					],
					"default": "Default",
					"description": "%config.dialog.pullBranch.squashMessageFormat.description%"
				},
				"git-graph.dialog.pullBranch.squashCommits": {
					"type": "boolean",
					"default": false,
					"description": "%config.dialog.pullBranch.squashCommits.description%"
				},
				"git-graph.dialog.rebase.ignoreDate": {
					"type": "boolean",
					"default": true,
					"description": "%config.dialog.rebase.ignoreDate.description%"
				},
				"git-graph.dialog.rebase.launchInteractiveRebase": {
					"type": "boolean",
					"default": false,
					"description": "%config.dialog.rebase.launchInteractiveRebase.description%"
				},
				"git-graph.dialog.resetCurrentBranchToCommit.mode": {
					"type": "string",
					"enum": [
						"Soft",
						"Mixed",
						"Hard"
					],
					"enumDescriptions": [
						"%config.dialog.resetCurrentBranchToCommit.mode.enumDescriptions.0%",
						"%config.dialog.resetCurrentBranchToCommit.mode.enumDescriptions.1%",
						"%config.dialog.resetCurrentBranchToCommit.mode.enumDescriptions.2%"
					],
					"default": "Mixed",
					"description": "%config.dialog.resetCurrentBranchToCommit.mode.description%"
				},
				"git-graph.dialog.resetUncommittedChanges.mode": {
					"type": "string",
					"enum": [
						"Mixed",
						"Hard"
					],
					"enumDescriptions": [
						"%config.dialog.resetUncommittedChanges.mode.enumDescriptions.0%",
						"%config.dialog.resetUncommittedChanges.mode.enumDescriptions.1%"
					],
					"default": "Mixed",
					"description": "%config.dialog.resetUncommittedChanges.mode.description%"
				},
				"git-graph.dialog.stashUncommittedChanges.includeUntracked": {
					"type": "boolean",
					"default": false,
					"description": "%config.dialog.stashUncommittedChanges.includeUntracked.description%"
				},
				"git-graph.graph.colours": {
					"type": "array",
					"items": {
						"type": "string",
						"description": "%config.graph.colours.items.description%",
						"pattern": "^\\s*(#[0-9a-fA-F]{6}|#[0-9a-fA-F]{8}|rgb[a]?\\s*\\(\\d{1,3},\\s*\\d{1,3},\\s*\\d{1,3}\\))\\s*$"
					},
